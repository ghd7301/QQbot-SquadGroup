# Squad QQBot (simplified) — configuration example
# Copy to .env and fill in. All values have sane defaults in qqbot/config.py.

# --- LLM (OpenAI-compatible chat completions) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=2

# --- Embedding (optional; leave EMBEDDING_MODEL empty to use free hash fallback) ---
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Bot identity & groups ---
BOT_QQ=123456789
WHITELISTED_GROUPS=983063031

# --- OneBot v11 reverse WebSocket (we host this; NapCat connects to it) ---
ONE_BOT_WS_HOST=0.0.0.0
ONE_BOT_WS_PORT=8081

# --- Knowledge ---
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_TOP_K=5
KNOWLEDGE_THRESHOLD=0.30

# --- Context ---
SHORT_CTX_MSGS=16
SHORT_CTX_CHARS=4000

# --- Reply constraints ---
MAX_REPLY_CHARS=500
RATE_LIMIT_PER_MIN=20

# --- Safety / runtime ---
DEDUP_WINDOW_SEC=30
END_TO_END_SEC=15
DB_PATH=qqbot.db
DRY_RUN=1
